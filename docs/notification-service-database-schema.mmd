erDiagram
    notification_log {
        string _id PK "generated by Mongo"
        string source UK "producing service, part of unique pair"
        string eventId UK "producer idempotency key, part of unique pair"
        string channel "EMAIL"
        string notificationType "template, for example MFA_CODE"
        string recipientUserId "member ObjectId in the auth-service database"
        string recipientAddress "masked, for example a***@example.com"
        string status "PENDING, SENT, FAILED, EXPIRED, REJECTED"
        int attempts
        string failureReason
        date requestedAt "time the producer asked"
        date createdAt "TTL index, 24h default"
        date sentAt
        date updatedAt
        string sourceTopic "set when dead-lettered"
        int sourcePartition "set when dead-lettered"
        long sourceOffset "set when dead-lettered"
    }
